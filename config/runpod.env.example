# Copy to .env.runpod on the laptop. Never commit the copy or real secrets.
SITE_API_URL=https://POD_ID-8101.proxy.runpod.net
HELPER_API_URL=https://POD_ID-8102.proxy.runpod.net

# Generate six distinct secrets, each at least 24 characters.
SITE_WORKER_TOKEN=CHANGE_ME
SITE_CONTROL_TOKEN=CHANGE_ME
HELPER_WORKER_TOKEN=CHANGE_ME
HELPER_CONTROL_TOKEN=CHANGE_ME
ECHO_ADMIN_TOKEN=CHANGE_ME
ECHO_METER_TOKEN=CHANGE_ME

WORKLOAD_SPECS=config/workloads.runpod.example.json
SEGMENT_DURATION_S=10
DEADLINE_S=9
SENSOR_POLL_INTERVAL_S=0.5
EPOCH_REPEATS=4
PROVISIONAL_WASHOUT_S=3
ECHO_PRIVATE_DIR=private/runpod-demo
ECHO_RUNS_DIR=runs/runpod-demo
AUDITOR_HOST=127.0.0.1
AUDITOR_PORT=8100
